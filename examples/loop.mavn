_mem m1 12;
_mem m2 10;
_mem m3 0;

_reg r1;
_reg r2;
_reg r3;
_reg r4;
_reg r5;
_reg r6;

_func main;
	la		r1, m1;
	lw		r2, 0(r1);

	la		r1, m2;
	lw		r3, 0(r1);

	li		r4, 0;

	and		r5, r2, r3;
	or		r6, r2, r3;

	beq		r5, r4, nema_zajednickih;

	b		upis;

nema_zajednickih:
	or		r5, r6, r4;

upis:
	la		r1, m3;
	sw		r5, 0(r1);
	nop;